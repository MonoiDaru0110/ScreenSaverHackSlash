layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 3
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 3

[node name="ReincSubTabButtons" type="HBoxContainer" parent="TopNavigationArea/ReincarnationSubNavContainer/MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ReincDummyTabBtn1" type="Button" parent="TopNavigationArea/ReincarnationSubNavContainer/MarginContainer/ReincSubTabButtons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "🌌 転生ツリー"

[node name="ReincDummyTabBtn2" type="Button" parent="TopNavigationArea/ReincarnationSubNavContainer/MarginContainer/ReincSubTabButtons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "✨ 特殊能力"
