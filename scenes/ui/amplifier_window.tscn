[sub_resource type="Shader" id="Shader_chain_seal"]
code = "shader_type canvas_item;

uniform vec2 rect_size = vec2(245.0, 92.0);

float sd_segment(vec2 p, vec2 a, vec2 b) {
	vec2 pa = p - a, ba = b - a;
	float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
	return length(pa - ba * h);
}

float sd_round_box(vec2 p, vec2 b, float r) {
	vec2 q = abs(p) - b + r;
	return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

vec2 chain_sdf(vec2 uv_chain) {
	float period = 24.0;
	float u1 = mod(uv_chain.x + period * 0.5, period) - period * 0.5;
	float d_ring_outer = sd_round_box(vec2(u1, uv_chain.y), vec2(8.5, 5.4), 5.0);
	float d_ring = abs(d_ring_outer + 1.6) - 1.8;

	float u2 = mod(uv_chain.x, period) - period * 0.5;
	float d_bar = sd_segment(vec2(u2, uv_chain.y), vec2(-5.5, 0.0), vec2(5.5, 0.0)) - 2.3;

	return vec2(d_ring, d_bar);
}

vec4 render_single_chain(vec2 uv_chain) {
	vec2 d2 = chain_sdf(uv_chain);
	float d = min(d2.x, d2.y);

	float outline_w = 1.6;
	float aa = 0.85;
	float alpha = 1.0 - smoothstep(outline_w - aa, outline_w + aa, d);
	if (alpha <= 0.001) {
		return vec4(0.0);
	}

	bool is_bar = d2.y < d2.x;
	float body_mask = 1.0 - smoothstep(-aa, aa, d);
	float ridge = clamp(1.0 - abs(d + 1.5) / 1.8, 0.0, 1.0);
	float light_dir = clamp(0.5 - uv_chain.y * 0.12, 0.0, 1.0);

	vec3 metal_base = is_bar ? vec3(0.46, 0.51, 0.60) : vec3(0.38, 0.43, 0.52);
	vec3 metal_hi = vec3(0.78, 0.83, 0.90);
	vec3 metal_dark = vec3(0.20, 0.23, 0.30);
	vec3 metal_col = mix(metal_dark, metal_base, smoothstep(-0.2, -1.2, d));
	metal_col = mix(metal_col, metal_hi, pow(ridge, 1.6) * (0.55 + 0.45 * light_dir));

	vec3 outline_col = vec3(0.05, 0.06, 0.09);
	vec3 col = mix(outline_col, metal_col, body_mask);
	return vec4(col, alpha);
}

void fragment() {
	vec2 p = UV * rect_size;
	vec2 c = rect_size * 0.5;
	vec2 q = p - c;

	vec2 dir1 = normalize(vec2(rect_size.x, rect_size.y));
	vec2 nrm1 = vec2(-dir1.y, dir1.x);
	vec2 uv1 = vec2(dot(q, dir1), dot(q, nrm1));

	vec2 dir2 = normalize(vec2(rect_size.x, -rect_size.y));
	vec2 nrm2 = vec2(-dir2.y, dir2.x);
	vec2 uv2 = vec2(dot(q, dir2), dot(q, nrm2));

	float edge_dist = sd_round_box(q, c - vec2(1.0), 8.0);
	float vig = smoothstep(-28.0, 0.0, edge_dist) * 0.32;
	vec4 out_col = vec4(vec3(0.02, 0.03, 0.06), vig);

	vec2 sh_off = vec2(1.5, 2.5);
	vec2 q_sh = q - sh_off;
	vec2 d1_sh = chain_sdf(vec2(dot(q_sh, dir1), dot(q_sh, nrm1)));
	float sh1 = 1.0 - smoothstep(0.0, 3.0, min(d1_sh.x, d1_sh.y));
	out_col = vec4(mix(out_col.rgb, vec3(0.0), sh1 * 0.48), max(out_col.a, sh1 * 0.48));

	vec4 c1 = render_single_chain(uv1);
	out_col = vec4(mix(out_col.rgb, c1.rgb, c1.a), max(out_col.a, c1.a));

	vec2 d2_sh = chain_sdf(vec2(dot(q_sh, dir2), dot(q_sh, nrm2)));
	float sh2 = 1.0 - smoothstep(0.0, 3.2, min(d2_sh.x, d2_sh.y));
	out_col.rgb = mix(out_col.rgb, vec3(0.0), sh2 * 0.52);
	out_col.a = max(out_col.a, sh2 * 0.48);

	vec4 c2 = render_single_chain(uv2);
	out_col = vec4(mix(out_col.rgb, c2.rgb, c2.a), max(out_col.a, c2.a));

	float d_plate = sd_round_box(q, vec2(86.0, 19.0), 6.0);
	float plate_sh = 1.0 - smoothstep(0.0, 4.0, sd_round_box(q - vec2(0.0, 2.0), vec2(86.0, 19.0), 6.0));
	out_col.rgb = mix(out_col.rgb, vec3(0.0), plate_sh * 0.5);
	out_col.a = max(out_col.a, plate_sh * 0.5);

	float plate_alpha = 1.0 - smoothstep(0.0, 1.2, d_plate);
	if (plate_alpha > 0.001) {
		float border_mask = 1.0 - smoothstep(-1.8, -0.6, d_plate);
		float rim_mask = (1.0 - smoothstep(-3.4, -2.0, d_plate)) * border_mask;
		vec3 plate_fill = vec3(0.07, 0.10, 0.17);
		vec3 plate_rim = vec3(0.42, 0.48, 0.58);
		vec3 plate_border = vec3(0.04, 0.05, 0.08);
		vec3 pcol = mix(plate_border, plate_fill, border_mask);
		pcol = mix(pcol, plate_rim, rim_mask);
		float fill_alpha = mix(0.96, 0.90, smoothstep(-3.4, -8.0, d_plate));
		out_col = vec4(mix(out_col.rgb, pcol, plate_alpha * fill_alpha), max(out_col.a, plate_alpha * fill_alpha));
	}

	float clip_mask = 1.0 - smoothstep(-1.0, 0.5, sd_round_box(q, c - vec2(2.0), 6.0));
	out_col.a *= clip_mask;

	COLOR = out_col;
}
"

